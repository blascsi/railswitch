# Railswitch production configuration.
#
# Copy this file to `.env` and fill in the required values
#
# Local development does not use this file. Mise loads `.env.local` if it
# exists. Fill in only the values you want to change from the defaults

##############
#  REQUIRED  #
##############

### Backend ###

# --- URLs ---
# Public host name of the backend
PHX_HOST=api.example.com
# Comma separated origins the frontend is served from
CORS_ORIGINS=https://app.example.com

# --- Secrets ---
# Generate each with: openssl rand -base64 48
SECRET_KEY_BASE=changeme
TOKEN_SIGNING_SECRET=changeme

# --- Database ---
# Password of the bundled Postgres; must match the one in DATABASE_URL
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=changeme
DATABASE_URL=ecto://postgres:changeme@postgres:5432/railswitch

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Address emails are sent from
MAIL_FROM=noreply@example.com

### Frontend ###

# --- URLs ---
# GraphQL endpoint of the backend
FRONTEND_API_URL=https://api.example.com/gql

##############
#  OPTIONAL  #
##############

### Backend ###

# --- Server ---
# Port the backend listens on
# PORT=4000

# --- Instance settings ---
# Allow new users to register
# SIGNUPS_ENABLED=true

# --- Database tuning ---
# POOL_SIZE=10
# Connect to the database over IPv6
# ECTO_IPV6=false

# --- Error tracking (Sentry) ---
# SENTRY_DSN=

### Frontend ###

# --- Error tracking (Sentry) ---
# FRONTEND_SENTRY_DSN=
# FRONTEND_SENTRY_TRACES_SAMPLE_RATE=0.01

# --- Railswitch feature flags (dogfooding) ---
# FRONTEND_RAILSWITCH_URL=
# FRONTEND_RAILSWITCH_API_KEY=

### Docker Compose ###

# Image tag to deploy
# RAILSWITCH_VERSION=latest
# Host port the frontend is published on
# WEB_PORT=3000
