{
  "name": "@railswitch/rule-evaluator",
  "version": "0.1.0",
  "description": "The rule evaluation logic for Railswitch flags",
  "private": true,
  "scripts": {
    "check": "pnpm run lint; pnpm run format",
    "check:ci": "pnpm run lint:ci && pnpm run format:ci",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:ci": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "feature-flags"
  ],
  "author": "Attila Blascsak <attila@blascsak.com>",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@railswitch/schemas": "workspace:*"
  },
  "devDependencies": {
    "@railswitch/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jsonc-parser": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
