{
  "name": "@railswitch/schemas",
  "version": "0.1.0",
  "description": "The JSON Schemas used by the Railswitch project",
  "private": true,
  "scripts": {
    "check": "pnpm run lint; pnpm run format",
    "check:ci": "pnpm run lint:ci && pnpm run format:ci",
    "codegen": "node scripts/generate-json-schema.ts",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:ci": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "keywords": [
    "schema",
    "json"
  ],
  "author": "Attila Blascsak <attila@blascsak.com>",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@railswitch/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
