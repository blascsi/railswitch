{
  "name": "@railswitch/sdk",
  "version": "0.1.0",
  "description": "The Javascript/Typescript SDK for Railswitch.",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run lint; pnpm run format",
    "check:ci": "pnpm run lint:ci && pnpm run format:ci",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:ci": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sdk"
  ],
  "author": "Attila Blascsak <attila@blascsak.com>",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "phoenix": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@railswitch/config": "workspace:*",
    "@railswitch/rule-evaluator": "workspace:*",
    "@railswitch/schemas": "workspace:*",
    "@types/phoenix": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
