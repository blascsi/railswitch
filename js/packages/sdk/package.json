{
	"name": "@railswitch/sdk",
	"version": "0.1.0",
	"description": "The Javascript/Typescript SDK for Railswitch.",
	"private": true,
	"scripts": {
		"build": "tsc",
		"check": "biome check --write",
		"check:ci": "biome ci",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"sdk"
	],
	"author": "Attila Blascsak <attila@blascsak.com>",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@railswitch/schemas": "workspace:*",
		"@railswitch/rule-evaluator": "workspace:*",
		"phoenix": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@railswitch/config": "workspace:*",
		"@types/phoenix": "catalog:",
		"typescript": "catalog:"
	}
}
