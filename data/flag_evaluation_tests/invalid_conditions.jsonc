{
  "testCases": [
    {
      "description": "A condition missing its value for a comparison operator does not match, even when the attribute is also missing from the context",
      "context": {
        "id": "123",
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "plan",
                  "operator": "eq",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "missing_value_matched",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "A condition with an unknown operator does not match, even when its attribute is present in the context",
      "context": {
        "id": "123",
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "id",
                  "operator": "unknown_operator",
                  "value": "123",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "unknown_operator_matched",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "A condition with an unknown type does not match",
      "context": {
        "id": "123",
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "unknown_type",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "unknown_type_matched",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
  ],
}
