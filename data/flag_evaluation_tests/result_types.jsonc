{
  "testCases": [
    {
      "description": "A matching rule whose result value is a number is skipped for the 'string' result type, and the default value is returned",
      "context": {
        "id": "123",
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "id",
                  "operator": "eq",
                  "value": "123",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": 42,
            },
          },
        ],
      },
      "defaultValue": "fallback",
      "expected": "fallback",
    },
