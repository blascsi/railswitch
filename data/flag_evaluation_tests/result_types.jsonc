    {
      "description": "A matching rule with a mismatched result value type is skipped, and evaluation falls through to a later matching rule of the correct type",
      "context": {
        "tier": "gold",
        "region": "EU",
      },
      "configuration": {
        "resultType": "number",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "tier",
                  "operator": "eq",
                  "value": "gold",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "not_a_number",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "region",
                  "operator": "eq",
                  "value": "EU",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": 10,
            },
          },
        ],
      },
      "defaultValue": 0,
      "expected": 10,
    },
    {
      "description": "Every matching rule having a mismatched result value type returns the default value",
