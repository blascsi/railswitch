{
  "testCases": [
    {
      "description": "A rule with an unknown result type is skipped, and evaluation falls through to a later matching rule",
      "context": {
        "tier": "gold",
        "region": "EU",
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "tier",
                  "operator": "eq",
                  "value": "gold",
                },
              ],
            },
            "result": {
              "type": "unknown_result_type",
              "value": "unknown_result_matched",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "region",
                  "operator": "eq",
                  "value": "EU",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "second_rule",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "second_rule",
    },
  ],
}
