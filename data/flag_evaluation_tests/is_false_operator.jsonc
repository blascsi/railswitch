{
  "testCases": [
    {
      "description": "Is false operator succeeds when the value in context is false",
      "context": {
        "isAdmin": false
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "isAdmin",
                  "operator": "is_false",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "is_false",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "is_false",
    },
    {
      "description": "Is false operator fails when the value in context is true",
      "context": {
        "isAdmin": true
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "isAdmin",
                  "operator": "is_false",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "is_false",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "Is false operator fails when the value in context is falsy but not false",
      "context": {
        "isAdmin": 0
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "isAdmin",
                  "operator": "is_false",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "is_false",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "Is false operator fails when the value in context is truthy",
      "context": {
        "role": "admin"
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "role",
                  "operator": "is_false",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "is_false",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
  ]
}
