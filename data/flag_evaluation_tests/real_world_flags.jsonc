{
  "testCases": [
    {
      "description": "An internal tester is enrolled in the new checkout flow before the enterprise canary rule is reached",
      "context": {
        "user": {
          "id": "u_8842",
          "email": "dana@acme.example",
          "account": {
            "plan": "ENTERPRISE",
            "region": "EU",
            "seats": 250,
          },
          "flags": {
            "isInternalTester": true,
          },
        },
        "app": {
          "version": "4.12.0",
        },
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "user.flags.isInternalTester",
                  "operator": "is_true",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "checkout_v2",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "user.account.plan",
                  "operator": "eq",
                  "value": "ENTERPRISE",
                },
                {
                  "type": "attribute",
                  "attribute": "user.account.region",
                  "operator": "eq",
                  "value": "EU",
                },
                {
                  "type": "attribute",
                  "attribute": "user.account.seats",
                  "operator": "gte",
                  "value": 100,
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "checkout_v2_canary",
            },
          },
        ],
      },
      "defaultValue": "checkout_v1",
      "expected": "checkout_v2",
    },
    {
      "description": "A trial account without a payment method falls through every rule to the blocked default",
      "context": {
        "account": {
          "subscription": {
            "tier": "TRIAL",
            "daysRemaining": 3,
            "paymentMethodOnFile": false,
          },
          "usage": {
            "monthlyExports": 47,
          },
        },
        "user": {
          "role": "MEMBER",
        },
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "account.subscription.tier",
                  "operator": "neq",
                  "value": "TRIAL",
                },
                {
                  "type": "attribute",
                  "attribute": "account.subscription.paymentMethodOnFile",
                  "operator": "is_true",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exports_unlimited",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "account.subscription.tier",
                  "operator": "eq",
                  "value": "TRIAL",
                },
                {
                  "type": "attribute",
                  "attribute": "account.subscription.paymentMethodOnFile",
                  "operator": "is_true",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exports_preview",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "user.role",
                  "operator": "eq",
                  "value": "ADMIN",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exports_unlimited",
            },
          },
        ],
      },
      "defaultValue": "exports_blocked",
      "expected": "exports_blocked",
    },
    {
      "description": "An iOS build on a recent OS receives the new video player through a nested or group",
      "context": {
        "device": {
          "platform": "IOS",
          "osVersion": 17.4,
        },
        "app": {
          "buildNumber": 1482,
          "channel": "STABLE",
        },
        "user": {
          "preferences": {
            "optedOutOfBeta": false,
          },
        },
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "user.preferences.optedOutOfBeta",
                  "operator": "is_true",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "video_player_legacy",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "user.preferences.optedOutOfBeta",
                  "operator": "is_false",
                },
                {
                  "combinator": "or",
                  "conditions": [
                    {
                      "combinator": "and",
                      "conditions": [
                        {
                          "type": "attribute",
                          "attribute": "device.platform",
                          "operator": "eq",
                          "value": "IOS",
                        },
                        {
                          "type": "attribute",
                          "attribute": "device.osVersion",
                          "operator": "gte",
                          "value": 17,
                        },
                        {
                          "type": "attribute",
                          "attribute": "app.buildNumber",
                          "operator": "gte",
                          "value": 1400,
                        },
                      ],
                    },
                    {
                      "type": "attribute",
                      "attribute": "app.channel",
                      "operator": "eq",
                      "value": "BETA",
                    },
                  ],
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "video_player_v3",
            },
          },
        ],
      },
      "defaultValue": "video_player_legacy",
      "expected": "video_player_v3",
    },
    {
      "description": "An org with audit log access in a US region enables the AI assistant while a disabled org override rule is skipped",
      "context": {
        "org": {
          "id": "org_5521",
          "features": "billing,sso,audit_log",
          "compliance": {
            "dataResidency": "US",
          },
        },
        "user": {
          "email": "sam@contoso.example",
          "groups": "engineering,platform",
        },
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": false,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "org.id",
                  "operator": "eq",
                  "value": "org_5521",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "ai_assistant_disabled_for_org",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "org.features",
                  "operator": "contains",
                  "value": "audit_log",
                },
                {
                  "type": "attribute",
                  "attribute": "org.compliance.dataResidency",
                  "operator": "eq",
                  "value": "US",
                },
                {
                  "type": "attribute",
                  "attribute": "user.groups",
                  "operator": "not_contains",
                  "value": "restricted",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "ai_assistant_enabled",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "org.compliance.dataResidency",
                  "operator": "neq",
                  "value": "US",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "ai_assistant_regional_review",
            },
          },
        ],
      },
      "defaultValue": "ai_assistant_disabled",
      "expected": "ai_assistant_enabled",
    },
    {
      "description": "A growth tier server key with no rate limit override receives the tiered numeric limit",
      "context": {
        "client": {
          "apiKey": {
            "scope": "SERVER",
            "tier": "GROWTH",
          },
          "reputation": {
            "abuseScore": 12,
          },
        },
        "request": {
          "endpoint": "/v1/messages",
        },
      },
      "configuration": {
        "resultType": "number",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "client.apiKey.overrideLimit",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": 100000,
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "client.reputation.abuseScore",
                  "operator": "gte",
                  "value": 50,
                },
              ],
            },
            "result": {
              "type": "value",
              "value": 10,
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "client.apiKey.tier",
                  "operator": "eq",
                  "value": "GROWTH",
                },
                {
                  "type": "attribute",
                  "attribute": "client.apiKey.scope",
                  "operator": "eq",
                  "value": "SERVER",
                },
                {
                  "type": "attribute",
                  "attribute": "client.reputation.abuseScore",
                  "operator": "lt",
                  "value": 50,
                },
              ],
            },
            "result": {
              "type": "value",
              "value": 5000,
            },
          },
        ],
      },
      "defaultValue": 1000,
      "expected": 5000,
    },
  ],
}
