    {
      "description": "The not equals operator succeeds when the float values differ by a single unit of precision",
      "context": {
        "score": 0.3,
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "score",
                "operator": "neq",
                "value": 0.30000000000000004,
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "not_equals",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "not_equals",
    },
