{
  "testCases": [
    {
      "description": "Exists operator succeeds when the attribute in context exists",
      "context": {
        "isAdmin": true
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "isAdmin",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exists",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "exists",
    },
    {
      "description": "Exists operator succeeds when the attribute in context exists, but is false",
      "context": {
        "isAdmin": false
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "isAdmin",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exists",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "exists",
    },
    {
      "description": "Exists operator succeeds when the attribute in context exists, but is zero",
      "context": {
        "count": 0
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "count",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exists",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "exists",
    },
    {
      "description": "Exists operator succeeds when the attribute in context exists, but is an empty string",
      "context": {
        "name": ""
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "name",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exists",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "exists",
    },
    {
      "description": "Exists operator fails when the attribute in context exists, but is null",
      "context": {
        "isAdmin": null
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "isAdmin",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exists",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "Exists operator fails when the attribute in context does not exist",
      "context": {
        "isAdmin": null
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "nonExisting",
                  "operator": "exists",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "exists",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
  ]
}
