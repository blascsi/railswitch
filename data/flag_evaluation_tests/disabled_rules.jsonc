{
  "testCases": [
    {
      "description": "A disabled rule doesn't evaluate to true",
      "context": {
        "id": "123",
      },
      "configuration": {
        "rules": [
          {
            "enabled": false,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "id",
                  "operator": "eq",
                  "value": "123",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "enabled",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "The same rule if enabled matches, and returns its result",
      "context": {
        "id": "123",
      },
      "configuration": {
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "id",
                  "operator": "eq",
                  "value": "123",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "enabled",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "enabled",
    },
    {
      "description": "A disabled rule is skipped, and evaluation falls through to a later matching rule",
      "context": {
        "id": "123",
        "role": "admin",
      },
      "configuration": {
        "rules": [
          {
            "enabled": false,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "role",
                  "operator": "eq",
                  "value": "admin",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "disabled_rule",
            },
          },
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "id",
                  "operator": "eq",
                  "value": "123",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "enabled_rule",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "enabled_rule",
    },
  ]
}
