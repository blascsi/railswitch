                {
                  "type": "attribute",
                  "attribute": "age",
                  "operator": "lt",
                  "value": 18,
                },
                {
                  "type": "attribute",
                  "attribute": "country",
                  "operator": "eq",
                  "value": "US",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "or_matched",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "or_matched",
    },
    {
      "description": "An 'or' group does not match when all of its conditions are false",
      "context": {
        "age": 30,
        "country": "US",
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "or",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "age",
                  "operator": "lt",
                  "value": 18,
                },
                {
                  "type": "attribute",
                  "attribute": "country",
                  "operator": "eq",
                  "value": "CA",
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "or_matched",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "An 'and' group does not match when its first condition is false",
      "context": {
        "age": 30,
        "country": "US",
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
