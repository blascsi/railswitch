{
  "testCases": [
    {
      "description": "The less than operator succeeds when the integer value in context is less than the value in the condition",
      "context": {
        "points": 99,
      },
      "configuration": {
        "resultType": "string",
        "rules": [
          {
            "enabled": true,
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "type": "attribute",
                  "attribute": "points",
                  "operator": "lt",
                  "value": 100,
                },
              ],
            },
            "result": {
              "type": "value",
              "value": "less_than",
            },
          },
        ],
      },
      "defaultValue": "rule_did_not_match",
      "expected": "less_than",
    },
    {
      "description": "The less than operator fails when the integer value in context equals the value in the condition",
      "context": {
        "points": 100,
      },
      "configuration": {
