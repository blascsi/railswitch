{
  "testCases": [
    {
      "description": "When the first rule does not match, evaluation falls through to a later matching rule",
      "context": {
        "tier": "gold",
        "region": "EU",
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "tier",
                "operator": "eq",
                "value": "silver",
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "first_rule",
          },
        },
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "region",
                "operator": "eq",
                "value": "EU",
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "second_rule",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "second_rule",
    },
    {
      "description": "When multiple rules match, the first matching rule wins",
      "context": {
        "tier": "gold",
        "region": "EU",
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "tier",
                "operator": "eq",
                "value": "gold",
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "first_rule",
          },
        },
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "region",
                "operator": "eq",
                "value": "EU",
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "second_rule",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "first_rule",
    },
  ],
}
