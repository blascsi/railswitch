          },
          "result": {
            "type": "value",
            "value": "equals",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "The equals operator succeeds when the boolean values are equal",
      "context": {
        "isAdmin": true,
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "isAdmin",
                "operator": "eq",
                "value": true,
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "equals",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "equals",
    },
    {
      "description": "The equals operator succeeds when both boolean values are false",
      "context": {
        "isAdmin": false,
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
