    {
      "description": "The equals operator fails when the number values are not equal",
      "context": {
        "points": 100,
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "points",
                "operator": "eq",
                "value": 200,
              },
