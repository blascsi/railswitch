{
  "testCases": [
    {
      "description": "The equals operator succeeds when the values are equal",
      "context": {
        "id": "123",
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "id",
                "operator": "eq",
                "value": "123",
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "equals",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "equals",
    },
    {
      "description": "The equals operator fails when the values are not equal",
      "context": {
        "id": "123",
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "id",
                "operator": "eq",
                "value": "1234",
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "equals",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "The equals operator fails when the values are equal, but not the same type",
      "context": {
        "id": "123",
      },
      "rules": [
        {
          "enabled": true,
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "type": "attribute",
                "attribute": "id",
                "operator": "eq",
                "value": 123,
              },
            ],
          },
          "result": {
            "type": "value",
            "value": "equals",
          },
        },
      ],
      "defaultValue": "rule_did_not_match",
      "expected": "rule_did_not_match",
    },
    {
      "description": "The equals operator succeeds when the number values are equal",
